                    { name: "Lavaş toyuq dürüm", desc: "Standart / Limuzin", price: "3 / 5 AZN", img: "https://images.unsplash.com/photo-1626700051175-6818013e1d4f?w=300&fit=crop" },
                    { name: "Lavaş katlet dürüm", desc: "Standart / Limuzin", price: "3 / 5 AZN", img: "https://images.unsplash.com/photo-1662116765993-455486803875?w=300&fit=crop" },
                    { name: "Lavaş sosis dürüm", desc: "Standart / Limuzin", price: "3 / 5 AZN", img: "https://images.unsplash.com/photo-1587314168485-3236d6710814?w=300&fit=crop" },
                    { name: "Çörəkdə Toyuq", desc: "Xırtıldayan çörəkdə", price: "3 AZN", img: "https://images.unsplash.com/photo-1606755962773-d324e0a13086?w=300&fit=crop" },
                    { name: "Ərəb şaurması", desc: "Xüsusi sousla", price: "5 AZN", img: "https://images.unsplash.com/photo-1529006557810-274b9b2fc783?w=300&fit=crop" }
                ]
            },
            {
                id: "soyuq-ickiler", name: "Soyuq İçkilər",
                items: [
                    { name: "Coca-Cola / Fanta / Sprite 1L", desc: "Sərinləşdirici", price: "3 AZN", img: "https://images.unsplash.com/photo-1622483767028-3f66f32aef97?w=300&fit=crop" },
                    { name: "FuseTea 1L", desc: "Buzlu çay", price: "4 AZN", img: "https://images.unsplash.com/photo-1556679343-c7306c1976bc?w=300&fit=crop" },
                    { name: "Ayran ev üsulu", desc: "Təbii qatıqdan", price: "2 AZN", img: "https://images.unsplash.com/photo-1589134707168-98e35cf8b713?w=300&fit=crop" },
                    { name: "Akroşka", desc: "Sərin və canlandırıcı", price: "2 AZN", img: "https://images.unsplash.com/photo-1605333396914-2314dce1f42e?w=300&fit=crop" }
                ]
            },
            {
                id: "isti-ickiler", name: "İsti İçkilər & Çay Dəstgahı",
                items: [
                    { name: "Acı coffee", desc: "Tünd qovrulmuş", price: "2 AZN", img: "https://images.unsplash.com/photo-1509042239860-f550ce710b93?w=300&fit=crop" },
                    { name: "Çay & Mürəbbə (Seçimlə)", desc: "Ağgilas, Qaragilas, Kiwi, Zoğal, Gavalı və s.", price: "7 AZN", img: "https://images.unsplash.com/photo-1576092768241-dec231879fc3?w=300&fit=crop" },
                    { name: "Çay & Şokolad/Şirniyyat", desc: "Alpengold, Pryannik, Vafli, Rulet", price: "7 AZN", img: "https://images.unsplash.com/photo-1544787219-7f47ccb76574?w=300&fit=crop" }
