<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Badu Kuba - Rəqəmsal Menyu</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #121212;
            --card-bg: #1e1e1e;
            --text-main: #f5f5f5;
            --text-muted: #aaaaaa;
            --accent: #d4af37; /* Qızılı rəng */
        }
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Poppins', sans-serif; }
        body { background-color: var(--bg-color); color: var(--text-main); line-height: 1.6; }
        
        /* Header */
        header { text-align: center; padding: 30px 20px; background: linear-gradient(180deg, #1a1a1a 0%, #121212 100%); position: sticky; top: 0; z-index: 100; box-shadow: 0 4px 15px rgba(0,0,0,0.5); }
        h1 { font-size: 28px; color: var(--accent); font-weight: 600; letter-spacing: 2px; }
        
        /* Kateqoriya Naviqasiyası */
        .categories { display: flex; overflow-x: auto; gap: 10px; padding: 15px 20px; scroll-behavior: smooth; }
        .categories::-webkit-scrollbar { display: none; }
        .cat-btn { background: var(--card-bg); border: 1px solid #333; color: var(--text-muted); padding: 8px 16px; border-radius: 20px; white-space: nowrap; cursor: pointer; transition: all 0.3s ease; font-size: 14px; }
        .cat-btn.active { background: var(--accent); color: #000; font-weight: 500; border-color: var(--accent); }
        
        /* Menyu Siyahısı */
        .menu-container { padding: 20px; max-width: 800px; margin: 0 auto; padding-bottom: 50px; }
        .menu-category { display: none; animation: fadeIn 0.5s ease; }
        .menu-category.active { display: block; }
        .cat-title { font-size: 22px; color: var(--accent); margin-bottom: 20px; border-bottom: 1px solid #333; padding-bottom: 10px; }
        
        /* Məhsul Kartı */
        .menu-item { display: flex; background: var(--card-bg); border-radius: 12px; margin-bottom: 15px; overflow: hidden; box-shadow: 0 4px 10px rgba(0,0,0,0.2); transition: transform 0.2s ease; }
        .menu-item:active { transform: scale(0.98); }
        .item-img { width: 110px; height: 110px; object-fit: cover; }
        .item-info { padding: 12px 15px; flex: 1; display: flex; flex-direction: column; justify-content: center; }
        .item-name { font-size: 16px; font-weight: 500; margin-bottom: 5px; }
        .item-desc { font-size: 12px; color: var(--text-muted); margin-bottom: 8px; }
        .item-price { font-size: 15px; color: var(--accent); font-weight: 600; margin-top: auto; }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>

    <header>
        <h1>BADU KUBA</h1>
    </header>

    <div class="categories" id="category-nav">
        <!-- Kateqoriyalar JS vasitəsilə bura əlavə olunacaq -->
    </div>

    <main class="menu-container" id="menu-container">
        <!-- Menyu məhsulları JS vasitəsilə bura əlavə olunacaq -->
    </main>

    <script>
        // Məhsulların siyahısı və vizual URL-ləri
