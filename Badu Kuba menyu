                ]
            },
            {
                id: "esas-yemekler", name: "Əsas Yeməklər",
                items: [
                    { name: "Sac (Toyuq / Quzu)", desc: "Tərəvəzlərlə ləziz sac", price: "24 / 32 AZN", img: "https://images.unsplash.com/photo-1603360946369-dc9bb6258143?w=300&fit=crop" },
                    { name: "Cızbız", desc: "Ənənəvi cızbız", price: "6 AZN", img: "https://images.unsplash.com/photo-1625938146369-adc83368bda7?w=300&fit=crop" },
                    { name: "Xaş", desc: "Səhərlərin vazkeçilməzi", price: "10 AZN", img: "https://images.unsplash.com/photo-1548943487-a2e4b43b485f?w=300&fit=crop" },
                    { name: "Toyuq çığırtması", desc: "Pomidor və yumurta ilə", price: "6 AZN", img: "https://images.unsplash.com/photo-1585937421612-70a008356fbe?w=300&fit=crop" }
                ]
            },
            {
                id: "setler", name: "Setlər & Qəlyan",
                items: [
                    { name: "Set 16", desc: "Çay, Pletka, Mürəbbə, Qəlyan", price: "16 AZN", img: "https://images.unsplash.com/photo-1516880016668-3006bb077b85?w=300&fit=crop" },
                    { name: "Set 20", desc: "Çay 2 ədəd, Mürəbbə, Pletka, Cola, Qəlyan", price: "20 AZN", img: "https://images.unsplash.com/photo-1527661591475-527312dd65f5?w=300&fit=crop" },
                    { name: "Qəlyan (Sadə)", desc: "Klassik qəlyan", price: "10 AZN", img: "https://images.unsplash.com/photo-1516880016668-3006bb077b85?w=300&fit=crop" }
                ]
            }
        ];

        const navContainer = document.getElementById('category-nav');
        const menuContainer = document.getElementById('menu-container');

        // Menyu render edilməsi
        menuData.forEach((category, index) => {
            // Naviqasiya butonları
            const btn = document.createElement('button');
            btn.className = `cat-btn ${index === 0 ? 'active' : ''}`;
            btn.innerText = category.name;
            btn.onclick = () => switchCategory(category.id, btn);
            navContainer.appendChild(btn);

            // Kateqoriya bölməsi
            const catSection = document.createElement('div');
            catSection.className = `menu-category ${index === 0 ? 'active' : ''}`;
            catSection.id = category.id;
            
            catSection.innerHTML = `<h2 class="cat-title">${category.name}</h2>`;
            
            category.items.forEach(item => {
                catSection.innerHTML += `
                    <div class="menu-item">
                        <img src="${item.img}" alt="${item.name}" class="item-img" loading="lazy">
                        <div class="item-info">
                            <h3 class="item-name">${item.name}</h3>
                            <p class="item-desc">${item.desc}</p>
                            <div class="item-price">${item.price}</div>
                        </div>
                    </div>
                `;
            });
            menuContainer.appendChild(catSection);
        });

        // Kateqoriya dəyişmə animasiyası
        function switchCategory(catId, btnElement) {
            // Butonları yenilə
            document.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('active'));
            btnElement.classList.add('active');
            
            // Bölmələri yenilə
            document.querySelectorAll('.menu-category').forEach(c => {
                c.classList.remove('active');
            });
            
            // Seçilmiş bölməni göstər
            const activeSection = document.getElementById(catId);
            activeSection.classList.add('active');
            
            // Naviqasiyanı mərkəzə sürüşdür (Mobil üçün)
            btnElement.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
        }
    </script>
</body>
</html>
