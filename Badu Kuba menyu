                ]
            },
            {
                id: "sorbalar", name: "Şorbalar",
                items: [
                    { name: "Mərci supu", desc: "Limon və nanə ilə", price: "4 AZN", img: "https://images.unsplash.com/photo-1547592166-23ac45744acd?w=300&fit=crop" },
